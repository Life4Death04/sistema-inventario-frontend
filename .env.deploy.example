# Public internet hop (works from anywhere, extra latency, exposed to WAN):
# BACKEND_ORIGIN=https://backend-production-xxxx.up.railway.app

# Private Railway network (same project, Wireguard-encrypted, no public
# exposure — recommended when frontend/backend/db share a Railway project).
# The hostname is the backend service's exact Railway service name, not its
# public domain slug — confirm it under the backend service's
# Settings -> Networking -> Private Networking before using this value.
# The port is the backend's container listen port (its Public Networking
# "Target Port"), not the public HTTPS port.
BACKEND_ORIGIN=http://sistema-inventario-backend.railway.internal:8080

# Local/homelab fallback (nginx-on-host or Docker Compose without Railway):
# BACKEND_ORIGIN=https://backend.example.invalid
